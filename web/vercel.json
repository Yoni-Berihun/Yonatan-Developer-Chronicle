{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "rewrites": [
    {
      "//": "Proxies the API through this domain so the session cookie stays first-party. Replace the host if Vercel assigns the backend project a different URL.",
      "source": "/api/:path*",
      "destination": "https://yonatan-times-api.vercel.app/api/:path*"
    },
    {
      "source": "/rss.xml",
      "destination": "https://yonatan-times-api.vercel.app/api/feed/rss.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://yonatan-times-api.vercel.app/api/feed/sitemap.xml"
    },
    {
      "//": "Single-page app fallback: every other path is handled by the router.",
      "source": "/((?!assets/|images/|favicon|robots).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
