# ---------------------------------------------------------------------------
# The frontend needs almost no configuration, because it talks to the API
# through a same-origin /api path rather than an absolute URL.
# ---------------------------------------------------------------------------

# Local development only: where Vite should proxy /api to.
# Defaults to http://localhost:4000 if unset.
VITE_API_TARGET=http://localhost:4000

# Optional build-time prerender (not used by the Railway `build:only` script).
# PRERENDER_API_URL=https://your-app.up.railway.app
# PUBLIC_SITE_URL=https://your-app.up.railway.app
