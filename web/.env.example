# ---------------------------------------------------------------------------
# The frontend needs almost no configuration, because it talks to the API
# through a same-origin /api path rather than an absolute URL.
# ---------------------------------------------------------------------------

# Local development only: where Vite should proxy /api to.
# Defaults to http://localhost:4000 if unset.
VITE_API_TARGET=http://localhost:4000

# Build time only (set this in Vercel, not here): the API the prerender step
# reads content from so shared links get real titles and images.
PRERENDER_API_URL=https://yonatan-times-api.onrender.com

# Build time only: used to build absolute URLs for canonical tags, Open Graph
# images and structured data.
PUBLIC_SITE_URL=https://yonatan-times.vercel.app
