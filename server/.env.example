# ---------------------------------------------------------------------------
# Copy to .env for local development. On Railway, set these in the Variables
# tab. Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Railway Postgres injects DATABASE_URL automatically in production.
# Locally, a free Neon project works well.
DATABASE_URL="postgresql://user:password@localhost:5432/yonatan_times?schema=public"

# Generate with: openssl rand -base64 48
# Changing this signs every existing admin session out.
JWT_SECRET="replace-me-with-at-least-32-random-characters"
JWT_EXPIRES_IN=7d

# The first admin account is created automatically on first boot.
# Leave ADMIN_PASSWORD unset and the server prints a generated one once.
ADMIN_EMAIL=yonatanberihun26@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME="Yonatan Berihun"

# Where the public site lives. Used for canonical URLs, RSS and the sitemap.
# On Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
PUBLIC_SITE_URL=http://localhost:5173

# Only needed for local Vite (cross-origin). In production the API serves the
# React build from the same origin. Comma-separated.
CORS_ORIGINS=http://localhost:5173

# Image hosting — https://cloudinary.com (free tier is plenty).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=yonatan-times

# Contact form notifications — https://resend.com (free tier: 3k emails/month).
RESEND_API_KEY=
RESEND_FROM_EMAIL="The Yonatan Times <onboarding@resend.dev>"
CONTACT_NOTIFY_EMAIL=yonatanberihun26@gmail.com

# Optional. Usually leave empty — the SPA already reads live API data.
FRONTEND_DEPLOY_HOOK_URL=

# One-shot on Railway: set to true, redeploy to seed, then clear.
RUN_SEED=
