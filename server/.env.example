# ---------------------------------------------------------------------------
# Copy to .env for local development. On Render, set these in the dashboard
# under Environment. Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Render Postgres connection string. Use the *Internal* URL when the API runs
# on Render, and the External URL when connecting from your laptop.
DATABASE_URL="postgresql://user:password@localhost:5432/yonatan_times?schema=public"

# Generate with: openssl rand -base64 48
# Changing this signs every existing admin session out.
JWT_SECRET="replace-me-with-at-least-32-random-characters"
JWT_EXPIRES_IN=7d

# The first admin account is created automatically on first boot.
# Leave ADMIN_PASSWORD unset and the server prints a generated one once.
ADMIN_EMAIL=yonatanberihun26@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME="Yonatan Berihun"

# Where the public site lives. Used for canonical URLs, RSS and the sitemap.
PUBLIC_SITE_URL=http://localhost:5173

# Only needed when the browser calls the API directly instead of through the
# Vercel proxy rewrite. Comma-separated.
CORS_ORIGINS=http://localhost:5173

# Image hosting — https://cloudinary.com (free tier is plenty).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=yonatan-times

# Contact form notifications — https://resend.com (free tier: 3k emails/month).
RESEND_API_KEY=
RESEND_FROM_EMAIL="The Yonatan Times <onboarding@resend.dev>"
CONTACT_NOTIFY_EMAIL=yonatanberihun26@gmail.com

# Vercel → Project Settings → Git → Deploy Hooks. Publishing content pings this
# so the prerendered frontend rebuilds with the new content.
VERCEL_DEPLOY_HOOK_URL=
